# Скопируйте этот файл в .env и заполните значения.
# Файл .env НЕЛЬЗЯ публиковать и коммитить в git.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAExampleExampleExampleExample

# ID чата, куда бот присылает заявки (ваш личный id или id группы, у групп он начинается с -)
TELEGRAM_CHAT_ID=123456789

# База для учёта броней (Upstash Redis). На Vercel создаются автоматически
# при подключении Storage → Upstash. Локально без них брони хранятся в памяти.
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=...

# Необязательно: принимать заявки только с этого домена (без / в конце)
# ALLOWED_ORIGIN=https://your-site.vercel.app

# Необязательно: порт локального сервера
# PORT=3000
